# Служебные папки прогонов (пакеты заданий, журналы) снаружи не видны —
# и уже существующие, и те, что появятся позже.
# Исключение — архив результатов прошлых прогонов (service/archive): это
# работа прогонов, её смотрят из браузера.
RewriteEngine On
RewriteRule (^|/)service/archive(/|$) - [L]
RewriteRule (^|/)service(/|$) - [F,L]

# Рабочие папки — данные, не код: скрипты отсюда не исполняются и не отдаются,
# что бы ни загрузили или ни назвали (asset.upload, rename, out/). Регистр не важен.
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pht|cgi|pl|py|sh)$">
  Require all denied
</FilesMatch>
